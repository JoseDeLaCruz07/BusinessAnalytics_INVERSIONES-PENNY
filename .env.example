# Copia este archivo a .env y completa tus credenciales. Nunca subas .env al repo.

# Finnhub: https://finnhub.io/dashboard
FINNHUB_API_KEY=

# SEC EDGAR (gratis, sin key): identificate con tu nombre y correo, es requisito de la SEC.
# Ejemplo: SEC_USER_AGENT=Penny Stock Analytics tu_correo@dominio.com
SEC_USER_AGENT=

# Asesor IA (Gemini): clave gratuita en https://aistudio.google.com/apikey
# GEMINI_MODEL es opcional; para ver los modelos que permite tu clave: python -m src.reports.asesor_ia --listar-modelos
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Tope de consultas a Gemini por dia (opcional, por defecto 40)
MAX_LLAMADAS_LLM_DIA=40

# Ruta de la base de datos SQLite local (desarrollo)
DATABASE_URL=sqlite:///data/penny_stocks.db

# Opcional: cadena de Supabase solo para scripts de evidencias/backtesting con --solo-lectura
SUPABASE_URL_LECTURA=
